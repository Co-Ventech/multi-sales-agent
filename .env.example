# MongoDB
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/email-agent

# JWT
JWT_SECRET=your-very-long-random-secret-here-at-least-32-chars

# Encryption (for SMTP passwords)
# ENCRYPTION_KEY must be exactly 32 characters
ENCRYPTION_KEY=32-char-key-here-xxxxxxxxxxxxxxx
# ENCRYPTION_IV must be exactly 16 characters
ENCRYPTION_IV=16charlongiv!!!

# OpenAI
OPENAI_API_KEY=sk-...

# App
PORT=3001
SERVER_URL=http://YOUR_SERVER_IP:3001
FRONTEND_URL=http://YOUR_SERVER_IP:5173
NODE_ENV=production

# Optional: Google Sheets (service account JSON as single line)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Optional: Log level (info, debug, warn, error)
LOG_LEVEL=info
